{
  "seed": 42,
  "data": {
    "height": 768,
    "width": 1024,
    "expected_per_class": 800,
    "expected_original_size": [
      2048,
      1536
    ],
    "split": [
      0.7,
      0.15,
      0.15
    ],
    "grayscale_3ch": true,
    "interpolation": "bilinear",
    "antialias": true,
    "root": "ZdraviBolesni",
