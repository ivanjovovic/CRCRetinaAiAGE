  "model": {
    "backbone": "tf_efficientnet_b3.in1k",
    "pretrained": true,
    "dropout": 0.3,
    "drop_path_rate": 0.0,
    "grad_checkpointing": true
  },
  "training": {
    "batch_size": 8,
    "grad_accum_steps": 4,
